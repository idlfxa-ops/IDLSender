rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Clients Collection: CRM client onboarding and records
    match /clients/{clientId} {
      allow get: if isSignedIn() && isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() 
        && isValidId(clientId)
        && incoming().userId == request.auth.uid
        && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 200
        && incoming().email is string && incoming().email.size() > 0 && incoming().email.size() <= 200
        && incoming().company is string && incoming().company.size() > 0 && incoming().company.size() <= 200;
      allow update: if isSignedIn() 
        && isOwner(existing().userId)
        && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isOwner(existing().userId);
    }

    // Prospects Collection: AI Hunted & Qualified Leads
    match /prospects/{prospectId} {
      allow get: if isSignedIn() && isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(prospectId)
        && incoming().userId == request.auth.uid
        && incoming().name is string && incoming().name.size() <= 200
        && incoming().company is string && incoming().company.size() <= 200;
      allow update: if isSignedIn()
        && isOwner(existing().userId)
        && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isOwner(existing().userId);
    }

    // Email Templates Collection
    match /templates/{templateId} {
      allow get: if isSignedIn() && isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(templateId)
        && incoming().userId == request.auth.uid
        && incoming().name is string && incoming().name.size() <= 200
        && incoming().subject is string && incoming().subject.size() <= 300;
      allow update: if isSignedIn()
        && isOwner(existing().userId)
        && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isOwner(existing().userId);
    }

    // Campaigns Collection
    match /campaigns/{campaignId} {
      allow get: if isSignedIn() && isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(campaignId)
        && incoming().userId == request.auth.uid
        && incoming().name is string && incoming().name.size() <= 200;
      allow update: if isSignedIn()
        && isOwner(existing().userId)
        && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isOwner(existing().userId);
    }

    // Email Delivery Reports Collection
    match /deliveryReports/{reportId} {
      allow get: if isSignedIn() && isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(reportId)
        && incoming().userId == request.auth.uid
        && incoming().campaignId is string && incoming().campaignId.size() <= 128;
      allow update: if isSignedIn()
        && isOwner(existing().userId)
        && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isOwner(existing().userId);
    }

    // Project Milestones Collection
    match /milestones/{milestoneId} {
      allow get: if isSignedIn() && isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(milestoneId)
        && incoming().userId == request.auth.uid
        && incoming().title is string && incoming().title.size() <= 300;
      allow update: if isSignedIn()
        && isOwner(existing().userId)
        && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isOwner(existing().userId);
    }
  }
}
